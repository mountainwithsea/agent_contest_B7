{
  "name": "b7-reference-checker",
  "version": "0.1.3",
  "private": true,
  "description": "参考文献存在性、字段与证据核验",
  "author": "B7 project team",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "build": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.edu.zzu.b7.reference",
    "productName": "知衡文献核验",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "artifacts",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging/payload",
        "to": "payload"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "executableName": "B7ReferenceChecker",
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "B7-Reference-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "B7-Reference-Setup-${version}-${arch}.${ext}",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
