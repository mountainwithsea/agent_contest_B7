# Copy to .env and fill your own keys. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash

# Optional: scans and screenshots require a vision model.
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-omni-flash

# Optional supplementary registry; Crossref is queried first.
OPENALEX_API_KEY=
REFERENCE_DATA_DIR=data/reference
REFERENCE_PORT=8876
REFERENCE_FAKE_DNS=0

# Fresh clones use public conversion; no Ruby/Node formatter installation required.
# Set local after restoring the optional runtime described in shared/README.md.
ANYSTYLE_FORMAT_MODE=remote
